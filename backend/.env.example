# Generate root .env: cd backend && python -m osc.init_config
# Separate random tokens of at least 24 characters are required.
OSC_ADMIN_TOKEN=
OSC_REVIEWER_TOKEN=
OSC_INGEST_TOKEN=
OSC_INTEGRATION_TOKEN=
OSC_REVIEWER_NAME=Специалист
OSC_DB_PASSWORD=
# Configure only cameras/streams you are authorized to access. URL-encode credentials.
CAMERA_01_URL=rtsp://USER:PASSWORD@CAMERA_HOST:554/STREAM
OSC_MAX_QUEUE=300
OSC_MIN_FREE_MB=512
OSC_UNEVENTFUL_RETENTION_HOURS=24
# Optional presentation account; generate securely or configure in the site's admin settings.
OSC_PRESENTATION_USERNAME=presenter
OSC_PRESENTATION_PASSWORD=
# Optional stable secret; if unset, encrypted settings derive their key from OSC_ADMIN_TOKEN.
OSC_SETTINGS_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
